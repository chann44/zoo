JWT_SECRET=change-me-to-a-long-random-string
# encrypts vault secrets, agent keys and app profiles; falls back to JWT_SECRET when unset
ZOO_SECRETS_KEY=
# old keys, comma separated, kept only until `make rotate-secrets` has run
ZOO_SECRETS_KEY_PREVIOUS=
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=http://localhost:3000
# API URL the dashboard calls, read when the web container starts
ZOO_API_URL=http://localhost:8000
ZOO_SSH_DIR=~/.ssh
ZOO_DOMAIN=zoo.example.com
ZOO_GRAFANA_DOMAIN=grafana.zoo.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=
ZOO_PUBLIC_IP=
ZOO_RUNTIME=kata
ZOO_SANDBOX_IMAGE=zoo-sandbox:latest
ZOO_CODE_IMAGE=zoo-code:latest
ANTHROPIC_API_KEY=
ZOO_AGENT_MODEL=anthropic/claude-sonnet-5-5
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
